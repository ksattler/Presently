    "While presenting, the document window shows the presenter view: current slide, next slide, upcoming pages, notes, elapsed time and clock.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der Präsentation zeigt das Dokumentfenster die Referentenansicht: aktuelle Folie, nächste Folie, folgende Seiten, Notizen, verstrichene Zeit und Uhr."
          }
        }
      }
