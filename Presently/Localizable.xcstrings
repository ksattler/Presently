    "Beamer notes “%@” are active, but the pages have a normal slide format – only half a page is shown.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beamer-Notizen „%@“ sind aktiv, die Seiten haben aber ein normales Folienformat – gezeigt wird nur eine halbe Seite."
          }
        }
      }
    },
    "Beamer overlays (consecutive pages with the same label) share one note.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beamer-Overlays (aufeinanderfolgende Seiten mit gleichem Label) teilen sich eine Notiz."
